# Keep the build context small and make the build reproducible: anything the
# Dockerfile needs is copied explicitly.

# Python build and test artefacts
.venv
venv
build
dist
*.egg-info
**/__pycache__
*.py[cod]
.pytest_cache
.coverage
coverage.xml
.ruff_cache
.mypy_cache

# Repository and tooling
.git
.github
.gitignore
.vscode
.idea
.claude

# Runtime and throwaway data
logs/*
!logs/.keep
tmp
*.log
.env

# Tests are not needed in the image
tests
